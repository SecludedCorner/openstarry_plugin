{
  "name": "@openstarry-plugin/web-ui",
  "version": "0.1.0",
  "description": "Web-based UI plugin for browser access to OpenStarry agents",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b && node -e \"require('fs').cpSync('src/static','dist/static',{recursive:true})\"",
    "clean": "rimraf --glob dist \"*.tsbuildinfo\"",
    "dev": "tsc -b --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@openstarry/sdk": "workspace:*",
    "@openstarry/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.2.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.0.18"
  },
  "keywords": ["openstarry", "plugin", "web-ui", "browser", "remote-attach"],
  "license": "MIT"
}
