{
  "name": "@openstarry-plugin/workflow-engine",
  "version": "0.1.0",
  "description": "Workflow Engine MVP — declarative YAML-based multi-step task orchestration",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf --glob dist \"*.tsbuildinfo\"",
    "dev": "tsc -b --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@openstarry/sdk": "workspace:*",
    "@openstarry/shared": "workspace:*",
    "mustache": "^4.2.0",
    "yaml": "^2.3.4",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.0.18"
  },
  "keywords": [
    "openstarry",
    "plugin",
    "workflow",
    "automation",
    "orchestration"
  ],
  "license": "MIT"
}
